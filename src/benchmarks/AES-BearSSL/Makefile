LIBBEARSSL32 = -I../../../$(LIBDIR)/bearssl-0.6/inc -L../../../$(LIBDIR)/bearssl-0.6 -lbearssl

all: aes_big_cbc aes_big_gcm aes_big_ccm aes_big_eax aes_ct_cbc aes_ct_gcm aes_ct_ccm aes_ct_eax aes_ct64_cbc aes_ct64_gcm aes_ct64_ccm aes_ct64_eax aes_small_cbc aes_small_gcm aes_small_ccm aes_small_eax aes_x86ni_cbc aes_x86ni_gcm aes_x86ni_ccm aes_x86ni_eax

aes_big_cbc:
	@echo "=====> $(CC) $(CFLAGS) -m32 ../../common.c $@.c -o $(DESTDIR)/$@-$(SUFFIX) $(LIBBEARSSL32)"
	@$(CC) $(CFLAGS) -m32 ../../common.c $@.c -o $(DESTDIR)/$@-$(SUFFIX) $(LIBBEARSSL32)

